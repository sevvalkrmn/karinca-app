# ============================================================
# Karınca — environment variable template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ---------- AI service (Python/FastAPI) — SERVER-SIDE ONLY ----------
# These keys must live only on the server. They must NEVER ship in the
# Android client. The Android app talks to Supabase with the ANON key
# and relies on Row-Level Security; sensitive operations go through the
# FastAPI service.

# Supabase project URL (safe to expose)
SUPABASE_URL=

# Supabase SERVICE-ROLE key — full DB access, bypasses RLS. SERVER ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider key for the narrator (swappable provider). SERVER ONLY.
LLM_API_KEY=
# Identifier of the active provider/model behind the narrate() boundary.
LLM_PROVIDER=
LLM_MODEL=

# Secret used to authenticate the scheduled cron trigger -> FastAPI.
REPORT_CRON_SECRET=

# ---------- Android client (public config only) ----------
# The client only ever uses the ANON key. Real values go in
# local.properties / build config, which is gitignored — not here.
# SUPABASE_ANON_KEY=
